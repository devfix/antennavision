{
  "metadata": {
    "setup_name": "upa-test"
  },
  "variables": {
    "system_wavelength": 0.1,
    "wavelength": "system_wavelength",
    "distance": "1000*wavelength",
    "dipole_length": "0.5*wavelength"
  },
  "num_params": {
    "system_wavelength": 0.1,
    "n_polar": 101,
    "n_azimuth": 101
  },
  "references": [
    {
      "id": "ref_tx",
      "origin": "",
      "pos": [0, 0, 0],
      "rot": {"yaw": 0, "pitch": 0, "roll": 0}
    },
    {
      "id": "ref_rx",
      "origin": "",
      "pos": [0, 0, "distance"],
      "rot": {"yaw": 0.5, "pitch": 0.5, "roll": 0}
    },
    {
      "id": "ref_rect",
      "origin": "",
      "pos": [0, 0, "distance"]
    }
  ],
  "antennas": [
    {
      "id": "tx",
      "type": "UPA",
      "ref": "ref_tx",
      "spacing_x": "wavelength * 0.5",
      "spacing_y": "wavelength * 0.5",
      "size_x": 8,
      "size_y": 8,
      "rot": {"yaw": 0, "pitch": 0.5, "roll": 0},
      "radiator": {
        "type": "StandingWaveDipole",
        "dipole_length": "dipole_length"
      },
      "codebook":
      {
        "file": "../codebooks/upa_dft_codebook.json",
        "ratio": "1000",
        "row": "8",
        "col": "8"
      }
    },
    {
      "id": "rx",
      "ref": "ref_rx",
      "type": "StandingWaveDipole",
      "dipole_length": "dipole_length"
    }
  ],
  "geometries": [
    {
      "id": "geo",
      "type": "SphericalRectangle",
      "center": [0, 0, 0],
      "normal": [0, 0, 1],
      "e1": [1, 0, 0],
      "radius": "distance",
      "polar_span": "pi",
      "azimuth_span": "pi"
    }
  ],
  "sweeps": [
    {
      "id": "sweep",
      "type": "ListSweep",
      "values": [0.09, 0.1, 0.11]
    }
  ],
  "tasks": [
    {
      "type": "compute_voltage_field",
      "tx": "tx",
      "rx": "rx",
      "geo": "geo",
      "sweep": "sweep"
    }
  ]
