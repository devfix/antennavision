{
  "metadata": {
    "setup_name": "upa-test"
  },
  "num_params": {
    "system_wavelength": 0.1
  },
  "variables": {
    "wavelength": "system_wavelength",
    "distance": "1000*wavelength",
    "dipole_length": "0.5*wavelength"
  },
  "references": [
    {
      "id": "ref_tx",
      "origin": "",
      "pos": [0, 0, 0],
      "rot": {"yaw": 0, "pitch": 0, "roll": 0}
    },
    {
      "id": "ref_rx",
      "origin": "",
      "pos": [0, 0, "2*wavelength"],
      "rot": {"yaw": 0, "pitch": "pi/2", "roll": 0}
    }
  ],
  "antennas": [
    {
      "id": "tx",
      "type": "UPA",
      "ref": "ref_tx",
      "spacing_x": "wavelength * 0.5",
      "spacing_y": "wavelength * 0.5",
