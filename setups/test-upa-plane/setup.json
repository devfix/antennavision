      "n_dim1": 21,
      "n_dim2": 21,
      "sweep": "test_sweep"
    },
    {
      "type": "RxVoltageField@Wavelength",
      "ref": "",
      "tx": "tx",
      "rx": "rx",
      "geo": "test_spherical_rectangle",
      "n_dim1": 21,
      "n_dim2": 21,
      "sweep": "test_sweep"
    }
  ]
