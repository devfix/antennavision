{
  "metadata": {
    "setup_name": "upa-test"
  },
  "variables": {
    "system_wavelength": 0.1,
    "wavelength": "system_wavelength",
    "distance": "1000*wavelength",
    "dipole_length": "0.5*wavelength"
  },
  "references": [
    {
      "id": "ref_tx",
      "origin": "",
      "pos": {"x": 0, "y": 0, "z": 0},
      "rot": {"yaw": 0, "pitch": 0, "roll": 0.25}
    },
    {
      "id": "ref_rx",
      "origin": "",
      "pos": {"x": 0, "y": 0, "z": "distance"},
      "rot": {"yaw": 0, "pitch": 0.5, "roll": 0}
    },
    {
      "id": "ref_rect",
      "origin": "",
      "pos": {"x": 0, "y": 0, "z": "distance"}
    }
  ],
  "antennas": [
    {
      "id": "tx",
      "type": "UPA",
      "ref": "ref_tx",
      "spacing_x": "wavelength * 0.5",
      "spacing_y": "wavelength * 0.5",
      "size_x": 8,
      "size_y": 8,
      "rot": {"yaw": 0, "pitch": 0.5, "roll": 0},
      "radiator": {
        "type": "StandingWaveDipole",
        "dipole_length": "dipole_length"
      },
      "codebook":
      {
        "file": "../codebooks/upa_dft_codebook.json",
        "ratio": "1000",
        "row": "8",
        "col": "8"
      }
    },
    {
      "id": "rx",
      "ref": "ref_rx",
      "type": "StandingWaveDipole",
      "dipole_length": "dipole_length"
    }
  ],
  "tasks": [
    {
      "type": "plot_gain_over_geo_sphere",
      "tx": "tx",
      "rx": "rx",
      "ref_center": "",
      "ref_rect": "ref_rect",
      "wavelength": "wavelength",
      "polar": 1.0,
      "azimuth": 1.0,
      "n_points_polar": 101,
      "n_points_azimuth": 101,
      "dir_north": {
        "x": 0, "y": 0, "z": 1
      }
    },
    {
      "type": "plot_gain_over_local_sphere",
      "tx": "tx",
      "rx": "rx",
      "wavelength": "wavelength",
      "ref": "",
      "radius": "distance",
      "polar_min": 0,
      "polar_max": 0.5,
      "azimuth_min": 1.9,
      "azimuth_max": 0.1,
    }
  ]
}
