#include "../include/eval/scalarfield.old.hpp"
#include <ansi_color.hpp>
#include <nlopt.hpp>
#include <print>
#include <utility>
#include "memory.hpp"

namespace
{
    // Concept: Checks if type T belongs to the Curve variant
    template <typename T, typename Variant>
    concept is_variant_alternative = requires(T val) {
        Variant{ val };
    };
}

template <typename ScalarType>
ScalarField<ScalarType>::ScalarField(std::string_view id, field_t&& field, math::NumParams const& num_params) :
    id(id), field(std::move(field)), num_params(num_params)
{}

template <typename ScalarType>
std::pair<pos_t, double> ScalarField<ScalarType>::argmax_line_abs(pos_t const& pos_a, pos_t const& pos_b) const
{
    pos_t const delta = pos_b - pos_a;
    math::OptParams const params{[this, &pos_a, &delta](double const x) -> double { return -std::abs(field(pos_a + x * delta, num_params.system_wavelength)); },
        0.0,
        1.0,
        num_params};
    auto [x_min, f_min] = math::f_min(params);
    pos_t pos_max = pos_a + x_min * delta;
    return {pos_max, std::abs(field(pos_max, num_params.system_wavelength))};
}

template <typename ScalarType>
std::pair<pos_t, double> ScalarField<ScalarType>::argmax_arc_abs(geometry::CircleArc const& arc) const
{
    math::OptParams const params{[&](double angle) -> double { return -std::abs(field(arc.pos_at_angle(angle), num_params.system_wavelength)); },
        -0.5 * arc.angle_span(),
        0.5 * arc.angle_span(),
        num_params};
    auto [angle_max, f_min] = math::f_min(params);
    pos_t pos_max = arc.pos_at_angle(angle_max);
    return {pos_max, std::abs(field(pos_max, num_params.system_wavelength))};
}

template <typename ScalarType>
std::pair<pos_t, double> ScalarField<ScalarType>::calc_beamwidth(geometry::CircleArc const& arc, double const ratio) const
{
    auto const [pos_beam, intensity] = argmax_arc_abs(arc);
    auto circle_hpbw = geometry::CircleArc("", arc.center(), arc.normal(), pos_beam - arc.center(), POS_ZERO, arc.radius(), arc.angle_span()).normalized();
    math::OptParams const params{[&](double const angle) -> double
        {
            pos_t const pos = circle_hpbw.pos_at_angle(angle);
            return math::square(std::abs(field(pos, num_params.system_wavelength)) - ratio * intensity);
        },
        0.0,
        0.5 * arc.angle_span(),
        num_params};
    auto [angle1, eps1] = math::f_min(params);

    reconstruct_at(circle_hpbw, circle_hpbw.rotate(-0.5 * arc.angle_span()));

    auto [angle2_inv, eps2] = math::f_min(params);
    double angle2 = 0.5 * arc.angle_span() - angle2_inv;

    return {pos_beam, angle1 + angle2};
}

template <typename ScalarType>
std::pair<Vec3Array, ComplexArray> ScalarField<ScalarType>::eval_geometry(geometry::Geometry const& geo, double wavelength) const
{
    Vec3Array positions = std::visit(
        [this]<typename T>(T const& shape) -> Vec3Array
        {
            if constexpr (is_variant_alternative<T, geometry::Curve>)
            {
                Vec3Array positions(num_params.n_linear1, 1);
                for (ComplexArray::index_type k = 0; k < num_params.n_linear1; k++)
                {
                    double const t = static_cast<double>(k) / static_cast<double>(num_params.n_linear1 - 1);
                    positions(k, 0) = geometry::curve::get_pos_at(shape, t);
                }
                return positions;
            }
            else
            {
                Vec3Array positions(num_params.n_linear2, num_params.n_linear1);
                for (ComplexArray::index_type k2 = 0; k2 < num_params.n_linear2; k2++)
                {
                    double const t2 = static_cast<double>(k2) / static_cast<double>(num_params.n_linear2 - 1);
                    for (RealArray::index_type k1 = 0; k1 < num_params.n_linear1; k1++)
                    {
                        double const t1 = static_cast<double>(k1) / static_cast<double>(num_params.n_linear1 - 1);
                        positions(k2, k1) = geometry::surface::get_pos_at(shape, t1, t2);
                    }
                }
                return positions;
            }
        }, geo);
    return {positions, eval(positions, wavelength)};
}

template <typename ScalarType>
ComplexArray ScalarField<ScalarType>::eval(Vec3Array const& positions, double wavelength) const
{
    ComplexArray values(positions.shape());
    std::ranges::transform(positions, values.begin(), [&field = std::as_const(field), &wavelength](pos_t const& pos) { return field(pos, wavelength); });
    return values;
}

// =========================================================================
// Explicit Instantiation
// =========================================================================
// This forces the compiler to generate the machine code for these two types
// inside scalarfield.o so that the linker can find them.
template class ScalarField<double>;
template class ScalarField<complex_t>;
